# Most Azure values are written by `azd up` and copied from the azd environment
# into ./.env by the postdeploy hook.

# Provisioned Azure resources
AZURE_ENV_NAME=
AZURE_LOCATION=
AZURE_RESOURCE_GROUP=
AZURE_SUBSCRIPTION_ID=
AZURE_AI_PROJECT_ID=
AZURE_AI_PROJECT_NAME=
AZURE_AI_PROJECT_ENDPOINT=
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-5.4-nano
APPLICATIONINSIGHTS_CONNECTION_STRING=
AZURE_CONTAINER_REGISTRY_ENDPOINT=
AZURE_REGISTRY=
AZURE_CONTAINER_REGISTRY_NAME=
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_CONTAINER_ENVIRONMENT_NAME=
AZURE_MANAGED_IDENTITY_NAME=

# Deterministic travel scenario MCP host
TRAVEL_MCP_HOST_URL=
TRAVEL_MCP_IMAGE=
WEATHER_MCP_URL=
HOTELS_MCP_URL=
TRAVEL_MCP_URL=
TRAVEL_MCP_CPU=1
TRAVEL_MCP_MEMORY=2.0Gi
TRAVEL_MCP_MIN_REPLICAS=1

# Hosted agent resources
HOSTED_AGENT_CPU=1
HOSTED_AGENT_MEMORY=2Gi
HYPOTHESIS_HOSTED_AGENT_NAME=scenario-hosted-hypothesis-agent
HYPOTHESIS_HOSTED_AGENT_IMAGE=

# Durable workflow state
WORKFLOW_STORAGE_CONTAINER=agent-workflows
WORKFLOW_TTL_HOURS=24
HARNESS_MAX_ITERATIONS=12

# Foundry toolboxes written by scripts.register_hypothesis_toolboxes
WEATHER_TOOLBOX_NAME=weather
HOTELS_TOOLBOX_NAME=hotels
TRAVEL_TOOLBOX_NAME=travel
WEATHER_TOOLBOX_ENDPOINT=
HOTELS_TOOLBOX_ENDPOINT=
TRAVEL_TOOLBOX_ENDPOINT=

# Optional comma-separated tool allowlists; empty exposes every toolbox tool.
WEATHER_ALLOWED_TOOLS=
HOTELS_ALLOWED_TOOLS=
TRAVEL_ALLOWED_TOOLS=

# Optional local AG-UI override. By default the URL is derived from the project
# endpoint and hosted agent name.
HYPOTHESIS_AGENT_INVOCATIONS_URL=
PORT=5178